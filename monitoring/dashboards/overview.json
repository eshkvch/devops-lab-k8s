{
    "uid":  "config-service-overview",
    "title":  "Config Service — Overview",
    "tags":  [
                 "config-service",
                 "overview"
             ],
    "timezone":  "browser",
    "schemaVersion":  39,
    "version":  2,
    "refresh":  "10s",
    "time":  {
                 "from":  "now-30m",
                 "to":  "now"
             },
    "templating":  {
                       "list":  [
                                    {
                                        "name":  "namespace",
                                        "type":  "constant",
                                        "query":  "config-service",
                                        "current":  {
                                                        "text":  "config-service",
                                                        "value":  "config-service"
                                                    }
                                    }
                                ]
                   },
    "panels":  [
                   {
                       "id":  1,
                       "type":  "timeseries",
                       "title":  "Backend API — requests/s",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "prometheus"
                                      },
                       "gridPos":  {
                                       "h":  8,
                                       "w":  12,
                                       "x":  0,
                                       "y":  0
                                   },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "reqps",
                                                            "noValue":  "0"
                                                        }
                                       },
                       "targets":  [
                                       {
                                           "expr":  "sum(rate(http_requests_total{namespace=\"$namespace\", path=~\"/api/.*\"}[1m]))",
                                           "legendFormat":  "backend api"
                                       }
                                   ]
                   },
                   {
                       "id":  3,
                       "type":  "timeseries",
                       "title":  "Backend API — latency p95",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "prometheus"
                                      },
                       "gridPos":  {
                                       "h":  8,
                                       "w":  12,
                                       "x":  12,
                                       "y":  0
                                   },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "s"
                                                        }
                                       },
                       "targets":  [
                                       {
                                           "expr":  "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{namespace=\"$namespace\", path=~\"/api/.*\"}[5m])) by (le))",
                                           "legendFormat":  "p95"
                                       }
                                   ]
                   },
                   {
                       "id":  4,
                       "type":  "timeseries",
                       "title":  "DB queries per second (by operation)",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "prometheus"
                                      },
                       "gridPos":  {
                                       "h":  8,
                                       "w":  12,
                                       "x":  0,
                                       "y":  8
                                   },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "ops",
                                                            "noValue":  "0"
                                                        }
                                       },
                       "targets":  [
                                       {
                                           "expr":  "sum by (operation) (rate(db_queries_total{namespace=\"$namespace\"}[1m]))",
                                           "legendFormat":  "{{operation}}"
                                       }
                                   ]
                   },
                   {
                       "id":  5,
                       "type":  "timeseries",
                       "title":  "Backend — RPS by pod",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "prometheus"
                                      },
                       "gridPos":  {
                                       "h":  8,
                                       "w":  12,
                                       "x":  12,
                                       "y":  8
                                   },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "reqps",
                                                            "noValue":  "0"
                                                        }
                                       },
                       "targets":  [
                                       {
                                           "expr":  "sum by (pod) (rate(http_requests_total{namespace=\"$namespace\", path=~\"/api/.*\"}[1m]))",
                                           "legendFormat":  "{{pod}}"
                                       }
                                   ]
                   },
                   {
                       "id":  6,
                       "type":  "stat",
                       "title":  "Backend pods UP",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "prometheus"
                                      },
                       "gridPos":  {
                                       "h":  4,
                                       "w":  4,
                                       "x":  0,
                                       "y":  16
                                   },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "noValue":  "0"
                                                        }
                                       },
                       "targets":  [
                                       {
                                           "expr":  "count(up{namespace=\"$namespace\", app=\"backend\"} == 1) or on() vector(0)"
                                       }
                                   ],
                       "options":  {
                                       "reduceOptions":  {
                                                             "calcs":  [
                                                                           "lastNotNull"
                                                                       ]
                                                         }
                                   }
                   },
                   {
                       "id":  7,
                       "type":  "stat",
                       "title":  "Frontend pods UP",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "prometheus"
                                      },
                       "gridPos":  {
                                       "h":  4,
                                       "w":  4,
                                       "x":  4,
                                       "y":  16
                                   },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "noValue":  "0"
                                                        }
                                       },
                       "targets":  [
                                       {
                                           "expr":  "count(up{namespace=\"$namespace\", app=\"frontend\"} == 1) or on() vector(0)"
                                       }
                                   ],
                       "options":  {
                                       "reduceOptions":  {
                                                             "calcs":  [
                                                                           "lastNotNull"
                                                                       ]
                                                         }
                                   }
                   },
                   {
                       "id":  8,
                       "type":  "stat",
                       "title":  "DB queries/s",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "prometheus"
                                      },
                       "gridPos":  {
                                       "h":  4,
                                       "w":  4,
                                       "x":  8,
                                       "y":  16
                                   },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "ops",
                                                            "noValue":  "0"
                                                        }
                                       },
                       "targets":  [
                                       {
                                           "expr":  "sum(rate(db_queries_total{namespace=\"$namespace\"}[1m])) or on() vector(0)"
                                       }
                                   ],
                       "options":  {
                                       "reduceOptions":  {
                                                             "calcs":  [
                                                                           "lastNotNull"
                                                                       ]
                                                         }
                                   }
                   },
                   {
                       "id":  9,
                       "type":  "stat",
                       "title":  "5xx errors/s",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "prometheus"
                                      },
                       "gridPos":  {
                                       "h":  4,
                                       "w":  4,
                                       "x":  12,
                                       "y":  16
                                   },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "reqps",
                                                            "noValue":  "0"
                                                        }
                                       },
                       "targets":  [
                                       {
                                           "expr":  "sum(rate(http_requests_total{namespace=\"$namespace\", status=~\"5..\", path!~\"/health|/metrics\"}[5m])) or on() vector(0)"
                                       }
                                   ],
                       "options":  {
                                       "reduceOptions":  {
                                                             "calcs":  [
                                                                           "lastNotNull"
                                                                       ]
                                                         }
                                   }
                   }
               ]
}
